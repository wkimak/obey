// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?
  createdAt DateTime @default(now())

  rules      Rule[]
  strategies Strategy[]
  reports    Report[]
}

model Rule {
  id          String   @id @default(cuid())
  userId      String
  key         String?
  title       String
  description String?

  scope       RuleScope
  strategyId  String?   // only for strategy-specific rules

  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  strategy      Strategy?      @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  strategyRules StrategyRule[]
  brokenRules   BrokenRule[]
}

enum RuleScope {
  GLOBAL
  STRATEGY
}

model Strategy {
  id        String   @id @default(cuid())
  userId    String
  name      String
  description String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  rules         Rule[]         // rules scoped to this strategy (Rule.strategyId)
  strategyRules StrategyRule[]
  reports       Report[]

  @@index([userId])
}

model StrategyRule {
  id           String   @id @default(cuid())
  strategyId   String
  ruleId       String
  section      String?
  displayText  String
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  rule     Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([strategyId, ruleId])
  @@index([strategyId])
  @@index([ruleId])
}

model Report {
  id         String   @id @default(cuid())
  userId     String
  strategyId String
  reportDate DateTime
  pnl        Decimal
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  brokenRules BrokenRule[]

  @@unique([userId, reportDate])
  @@index([userId])
  @@index([strategyId])
}

model BrokenRule {
  id        String   @id @default(cuid())
  reportId  String
  ruleId    String
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([reportId, ruleId])
  @@index([reportId])
  @@index([ruleId])
}
